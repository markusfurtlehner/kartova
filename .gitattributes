# Normalize text files to LF in the repository; check out native on Windows.
* text=auto

*.cs      text diff=csharp
*.axaml   text
*.csproj  text
*.sln     text eol=crlf
*.md      text
*.json    text
*.yml     text
*.sh      text eol=lf
*.ps1     text eol=crlf

# Binary assets must never be munged.
*.png     binary
*.ico     binary
*.icns    binary
*.jpg     binary
*.gif     binary
