<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Kartova.App.ViewModels"
        xmlns:views="using:Kartova.App.Views"
        xmlns:l="using:Kartova.App.Localization"
        mc:Ignorable="d"
        x:Class="Kartova.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Kartova"
        Width="1480" Height="940"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SurfaceBase}"
        Icon="/Assets/kartova.ico">

  <Grid RowDefinitions="Auto,*">

    <!-- ===================================================== Title bar -->
    <!-- A custom caption keeps the shell consistent across platforms instead of
         inheriting three different system title bars. On Linux the window manager
         insists on decorating anyway, so this degrades to a header strip there. -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="38" Background="{DynamicResource TitleBarBrush}"
          ColumnDefinitions="Auto,*,Auto"
          PointerPressed="OnTitleBarPressed"
          DoubleTapped="OnTitleBarDoubleTapped">

      <!-- Shifted right on macOS to clear the traffic lights. See ApplyPlatformChrome. -->
      <StackPanel x:Name="TitleBarLeft" Grid.Column="0" Orientation="Horizontal" Spacing="9"
                  Margin="12,0,0,0" VerticalAlignment="Center">
        <Image Source="/Assets/kartova-32.png" Width="17" Height="17" />
        <TextBlock Text="Kartova" FontWeight="SemiBold" FontSize="12.5"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding SelectionPathText}" Classes="tertiary"
                   FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"
                   TextTrimming="CharacterEllipsis" MaxWidth="620"
                   IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Results}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">

        <!-- About. In the caption rather than the options panel so it is reachable from the
             drive picker too, which is where someone lands before any scan exists. -->
        <Button Classes="caption" Command="{Binding ShowAboutCommand}" ToolTip.Tip="{l:T Window.About}">
          <TextBlock Text="i" FontSize="12.5" FontWeight="Bold" FontStyle="Italic" />
        </Button>

        <!-- Language selector. Sits left of the theme toggle, as asked, and shows the
             active language as a two-letter code so it needs no icon. -->
        <!-- The flyout opens on click by itself; no command needed. -->
        <Button Classes="caption" Width="46" ToolTip.Tip="{l:T Window.Language}">
          <TextBlock Text="{Binding LanguageCode, Source={x:Static l:Loc.Current}}"
                     FontSize="11.5" FontWeight="SemiBold" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <ItemsControl ItemsSource="{Binding Languages}" Margin="-4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <Button Classes="ghost language-item"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SetLanguageCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="11.5"
                                   Width="24" Foreground="{DynamicResource AccentBase}" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Classes="caption" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{l:T Window.Theme}">
          <TextBlock Text="◐" FontSize="14" />
        </Button>

        <!-- Window controls, hidden on Linux where the window manager draws its own.
             See MainWindow.ApplyPlatformChrome. -->
        <StackPanel x:Name="WindowControls" Orientation="Horizontal">
          <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="{l:T Window.Minimise}">
            <TextBlock Text="—" FontSize="11" />
          </Button>
          <Button Classes="caption" Click="OnMaximize" ToolTip.Tip="{l:T Window.Maximise}">
            <TextBlock Text="□" FontSize="12" />
          </Button>
          <Button Classes="caption close" Click="OnClose" ToolTip.Tip="{l:T Window.Close}">
            <TextBlock Text="✕" FontSize="12" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ======================================================= Screens -->
    <Panel Grid.Row="1">

      <views:VolumePickerView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Volumes}" />

      <views:ScanProgressView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Scanning}" />

      <views:ResultsView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Results}" />

      <views:DuplicatesView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Duplicates}" />

      <views:InsightsView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Insights}" />

      <views:ComparisonView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Comparison}" />

      <!-- ================================================ Confirm dialog -->
      <Panel IsVisible="{Binding IsConfirmingDelete}">
        <Border Background="{DynamicResource ScrimBrush}" />
        <Border Classes="card fade-in" Width="470" Padding="26"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceOverlay}"
                BorderBrush="{DynamicResource BorderStrong}"
                BoxShadow="0 24 64 0 #99000000">
          <StackPanel Spacing="16">
            <TextBlock Classes="title" Text="{Binding ConfirmTitle}" />
            <TextBlock Text="{Binding ConfirmBody}" Classes="secondary"
                       TextWrapping="Wrap" LineHeight="20" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Content="{l:T Common.Cancel}" Command="{Binding CancelDeleteCommand}" />
              <Button Classes="danger" Content="{l:T Common.Continue}" Command="{Binding ConfirmDeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>

      <!-- ================================================== About dialog -->
      <Panel IsVisible="{Binding IsAboutOpen}">

        <!-- Clicking the scrim dismisses, the way every other overlay in the app behaves. -->
        <Border Background="{DynamicResource ScrimBrush}"
                PointerPressed="OnAboutScrimPressed" />

        <Border Classes="card fade-in" Width="470"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceOverlay}"
                BorderBrush="{DynamicResource BorderStrong}"
                BoxShadow="0 24 64 0 #99000000">
          <StackPanel>

            <!-- Header: the mark, the name, and who wrote it. -->
            <StackPanel Margin="30,30,30,0" Spacing="18">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Image Source="/Assets/kartova-128.png" Width="56" Height="56"
                       VerticalAlignment="Top" />
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AboutName}" FontSize="25" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{l:T About.Version}" Classes="tertiary" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AboutVersion}" Classes="secondary"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />

                    <!-- Manual only. Nothing contacts GitHub unless this is pressed. -->
                    <Button Classes="link" Margin="6,0,0,0"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding !IsCheckingForUpdate}">
                      <TextBlock Text="{l:T About.CheckUpdates}" FontSize="11.5"
                                 Foreground="{DynamicResource AccentBase}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Result of a check: one sentence, plus a link only when there is something
                   to go and get. -->
              <Border IsVisible="{Binding HasCheckedForUpdate}"
                      Background="{DynamicResource SurfaceRaised}"
                      BorderBrush="{DynamicResource BorderSubtle}"
                      BorderThickness="1" CornerRadius="7" Padding="13,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding UpdateMessage}" Classes="secondary" FontSize="12"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Classes="link" IsVisible="{Binding UpdateFound}"
                          Command="{Binding OpenReleaseCommand}"
                          ToolTip.Tip="{l:T About.OpenRelease}">
                    <TextBlock Text="{l:T About.OpenRelease}" FontSize="12"
                               Foreground="{DynamicResource AccentBase}" />
                  </Button>
                </StackPanel>
              </Border>

              <TextBlock Text="{l:T About.Tagline}" Classes="secondary"
                         TextWrapping="Wrap" LineHeight="20" />

              <Border Classes="divider" />

              <!-- The credit itself, given its own line rather than buried in a details list. -->
              <StackPanel Spacing="5">
                <TextBlock Text="{l:T About.MadeBy}" Classes="caption" />
                <TextBlock Text="{Binding AboutAuthor}" FontSize="15.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBase}" />
              </StackPanel>

              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Text="{l:T About.Licence}" Classes="tertiary" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{l:T About.LicenceValue}" Classes="secondary"
                             FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Text="{l:T About.BuiltWith}" Classes="tertiary" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding AboutFramework}" Classes="secondary"
                             FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Text="{l:T About.System}" Classes="tertiary" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding AboutSystem}" Classes="secondary"
                             FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Text="{l:T About.Project}" Classes="tertiary" FontSize="12" />
                  <Button Grid.Column="1" Classes="link" Padding="0"
                          HorizontalAlignment="Left"
                          Command="{Binding OpenRepositoryCommand}"
                          ToolTip.Tip="{l:T About.OpenProject}">
                    <TextBlock Text="{Binding AboutRepositoryLabel}" FontSize="12"
                               Foreground="{DynamicResource AccentBase}" />
                  </Button>
                </Grid>
              </StackPanel>

              <TextBlock Text="{l:T About.Thanks}" Classes="tertiary" FontSize="11.5"
                         TextWrapping="Wrap" LineHeight="18" />
            </StackPanel>

            <!-- Footer: copyright on the left, actions on the right. -->
            <Border Margin="0,26,0,0" Padding="30,16"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding AboutCopyright}" Classes="tertiary"
                           FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9">
                  <Button Classes="ghost" Command="{Binding CopyAboutDetailsCommand}"
                          Content="{l:T About.Copy}"
                          IsVisible="{Binding !AboutDetailsCopied}" />
                  <Button Classes="ghost" IsEnabled="False"
                          Content="{l:T About.Copied}"
                          IsVisible="{Binding AboutDetailsCopied}" />
                  <Button Classes="accent" Command="{Binding CloseAboutCommand}"
                          Content="{l:T About.Close}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Panel>

    </Panel>
  </Grid>
</Window>
