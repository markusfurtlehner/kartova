<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Two complete palettes selected by theme variant. Dark is the default: a disk
    analyser is dominated by a dense, saturated treemap, and a dark shell keeps the
    data the brightest thing on screen.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <!-- ================================================================ Dark -->
    <ResourceDictionary x:Key="Dark">

      <!-- Surfaces, from deepest to most raised -->
      <SolidColorBrush x:Key="SurfaceSunken"   Color="#080A0F" />
      <SolidColorBrush x:Key="SurfaceBase"     Color="#0D1017" />
      <SolidColorBrush x:Key="SurfaceRaised"   Color="#141924" />
      <SolidColorBrush x:Key="SurfaceOverlay"  Color="#1A2130" />
      <SolidColorBrush x:Key="SurfaceHover"    Color="#1F2736" />
      <SolidColorBrush x:Key="SurfaceActive"   Color="#252E40" />

      <!-- Hairlines. Kept low-contrast so structure reads without drawing the eye. -->
      <SolidColorBrush x:Key="BorderSubtle"    Color="#1B2230" />
      <SolidColorBrush x:Key="BorderDefault"   Color="#252D3D" />
      <SolidColorBrush x:Key="BorderStrong"    Color="#33405A" />

      <!-- Text -->
      <SolidColorBrush x:Key="TextPrimary"     Color="#E9EDF5" />
      <SolidColorBrush x:Key="TextSecondary"   Color="#9AA4B8" />
      <SolidColorBrush x:Key="TextTertiary"    Color="#66718A" />
      <SolidColorBrush x:Key="TextInverse"     Color="#0B0E14" />

      <!-- Accent -->
      <SolidColorBrush x:Key="AccentBase"      Color="#4C8DFF" />
      <SolidColorBrush x:Key="AccentHover"     Color="#6BA1FF" />
      <SolidColorBrush x:Key="AccentPressed"   Color="#3B78E0" />
      <SolidColorBrush x:Key="AccentMuted"     Color="#1E2C47" />
      <SolidColorBrush x:Key="AccentGlow"      Color="#334C8DFF" />

      <!-- Semantic -->
      <SolidColorBrush x:Key="SuccessBase"     Color="#37D6B0" />
      <SolidColorBrush x:Key="WarningBase"     Color="#FFB24C" />
      <SolidColorBrush x:Key="DangerBase"      Color="#FF6B8A" />
      <SolidColorBrush x:Key="DangerHover"     Color="#FF849E" />
      <SolidColorBrush x:Key="DangerMuted"     Color="#3A1E27" />

      <!-- Capacity ring: free space track and the used-space sweep -->
      <SolidColorBrush x:Key="RingTrack"       Color="#1E2634" />

      <!-- Window chrome -->
      <SolidColorBrush x:Key="TitleBarBrush"   Color="#0A0D13" />
      <SolidColorBrush x:Key="ScrimBrush"      Color="#B305070C" />

      <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0"   Color="#141B2B" />
        <GradientStop Offset="0.55" Color="#0E131D" />
        <GradientStop Offset="1"   Color="#0B0E15" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="AccentSheen" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#4C8DFF" />
        <GradientStop Offset="1" Color="#8B7CFF" />
      </LinearGradientBrush>

    </ResourceDictionary>

    <!-- =============================================================== Light -->
    <ResourceDictionary x:Key="Light">

      <SolidColorBrush x:Key="SurfaceSunken"   Color="#E7EAF0" />
      <SolidColorBrush x:Key="SurfaceBase"     Color="#F4F6FA" />
      <SolidColorBrush x:Key="SurfaceRaised"   Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceOverlay"  Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceHover"    Color="#ECF0F7" />
      <SolidColorBrush x:Key="SurfaceActive"   Color="#DFE6F2" />

      <SolidColorBrush x:Key="BorderSubtle"    Color="#E2E6EE" />
      <SolidColorBrush x:Key="BorderDefault"   Color="#D2D8E4" />
      <SolidColorBrush x:Key="BorderStrong"    Color="#B3BDCE" />

      <SolidColorBrush x:Key="TextPrimary"     Color="#131822" />
      <SolidColorBrush x:Key="TextSecondary"   Color="#525C70" />
      <SolidColorBrush x:Key="TextTertiary"    Color="#7C8698" />
      <SolidColorBrush x:Key="TextInverse"     Color="#FFFFFF" />

      <SolidColorBrush x:Key="AccentBase"      Color="#2F6FE4" />
      <SolidColorBrush x:Key="AccentHover"     Color="#1D5CCC" />
      <SolidColorBrush x:Key="AccentPressed"   Color="#174CAB" />
      <SolidColorBrush x:Key="AccentMuted"     Color="#DFE9FC" />
      <SolidColorBrush x:Key="AccentGlow"      Color="#332F6FE4" />

      <SolidColorBrush x:Key="SuccessBase"     Color="#0E9E7E" />
      <SolidColorBrush x:Key="WarningBase"     Color="#C97A0A" />
      <SolidColorBrush x:Key="DangerBase"      Color="#D9375B" />
      <SolidColorBrush x:Key="DangerHover"     Color="#BE2A4C" />
      <SolidColorBrush x:Key="DangerMuted"     Color="#FCE4E9" />

      <SolidColorBrush x:Key="RingTrack"       Color="#DFE4ED" />

      <SolidColorBrush x:Key="TitleBarBrush"   Color="#EDF0F6" />
      <SolidColorBrush x:Key="ScrimBrush"      Color="#66000000" />

      <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0"   Color="#FFFFFF" />
        <GradientStop Offset="0.55" Color="#F2F5FA" />
        <GradientStop Offset="1"   Color="#E9EEF6" />
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="AccentSheen" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#2F6FE4" />
        <GradientStop Offset="1" Color="#6C5CE7" />
      </LinearGradientBrush>

    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Shape and rhythm constants, shared by both themes -->
  <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <x:Double x:Key="FontSizeCaption">11</x:Double>
  <x:Double x:Key="FontSizeBody">13</x:Double>
  <x:Double x:Key="FontSizeSubtitle">15</x:Double>
  <x:Double x:Key="FontSizeTitle">20</x:Double>
  <x:Double x:Key="FontSizeDisplay">30</x:Double>

</ResourceDictionary>
