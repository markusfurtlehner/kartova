<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DirStat.App.ViewModels"
             xmlns:views="using:DirStat.App.Views"
             xmlns:l="using:DirStat.App.Localization"
             mc:Ignorable="d"
             x:Class="DirStat.App.Views.ResultsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!-- Icons are drawn as geometry rather than glyphs. Symbol characters fall back
         inconsistently across Windows, macOS and Linux; paths render identically. -->
    <StreamGeometry x:Key="IconBack">M 10,2 L 4,8 L 10,14</StreamGeometry>
    <StreamGeometry x:Key="IconUp">M 8,13 L 8,3 M 3.5,7.5 L 8,3 L 12.5,7.5</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M 13,8 A 5,5 0 1 1 11.2,4.2 M 13,1.5 L 13,4.6 L 9.9,4.6</StreamGeometry>
    <StreamGeometry x:Key="IconOptions">M 2.5,4.5 L 13.5,4.5 M 2.5,8 L 13.5,8 M 2.5,11.5 L 13.5,11.5</StreamGeometry>
    <!-- Two offset sheets: the universal shorthand for a copy. -->
    <StreamGeometry x:Key="IconDuplicates">M 5.5,2.5 L 13.5,2.5 L 13.5,10.5 M 2.5,5.5 L 10.5,5.5 L 10.5,13.5 L 2.5,13.5 Z</StreamGeometry>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ================================================== Toolbar ================================================== -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="14,9">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Button Classes="ghost" Command="{Binding BackToVolumesCommand}"
                  ToolTip.Tip="{l:T Results.BackToDrives}" Padding="9,6">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconBack}" Stroke="{DynamicResource TextSecondary}"
                    StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="None" VerticalAlignment="Center" />
              <TextBlock Text="{l:T Results.Drives}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Width="1" Height="20" Background="{DynamicResource BorderSubtle}" Margin="4,0" />

          <!-- Zoom trail. Each hop returns the treemap to that folder. -->
          <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BreadcrumbViewModel">
                <StackPanel Orientation="Horizontal" Spacing="1">
                  <Button Classes="ghost crumb"
                          Content="{Binding Label}"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ZoomIntoCommand}"
                          CommandParameter="{Binding Node}" />
                  <TextBlock Text="/" Classes="tertiary" VerticalAlignment="Center"
                             IsVisible="{Binding !IsCurrent}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Filter box. Accepts a small query language, described in its tooltip. -->
        <Grid Grid.Column="1" MaxWidth="440" HorizontalAlignment="Right" Margin="16,0"
              ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" x:Name="FilterBox" Text="{Binding FilterText}"
                   Watermark="{l:T Results.FilterWatermark}"
                   ToolTip.Tip="{l:T Results.FilterTooltip}" />
          <TextBlock Grid.Column="1" Text="{Binding FilterSummary}" Classes="tertiary"
                     FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                     IsVisible="{Binding IsFiltered}" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Button Classes="ghost" Padding="11,6" Command="{Binding ShowDuplicatesCommand}"
                  ToolTip.Tip="{l:T Results.DuplicatesTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Data="{StaticResource IconDuplicates}" Stroke="{DynamicResource TextSecondary}"
                    StrokeThickness="1.5" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="None" VerticalAlignment="Center" />
              <TextBlock Text="{l:T Results.Duplicates}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Border Width="1" Height="20" Margin="3,0" Background="{DynamicResource BorderSubtle}" />

          <Button Classes="ghost icon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{l:T Results.ZoomOut}">
            <Path Data="{StaticResource IconUp}" Stroke="{DynamicResource TextSecondary}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="None" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding RefreshSelectedCommand}"
                  ToolTip.Tip="{l:T Results.Rescan}">
            <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextSecondary}"
                  StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="None" />
          </Button>
          <Button Classes="ghost icon" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="{l:T Results.Options}">
            <Path Data="{StaticResource IconOptions}" Stroke="{DynamicResource TextSecondary}"
                  StrokeThickness="1.6" StrokeLineCap="Round"
                  Width="16" Height="16" Stretch="None" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- =================================================== Panes =================================================== -->
    <Grid Grid.Row="1" ColumnDefinitions="424,4,*,4,286">

      <!-- ================================== Directory tree ================================== -->
      <!-- A flat, virtualized list rather than a nested tree control: only expanded branches
           become rows, so a scan of millions of nodes still realises a screenful at a time. -->
      <!-- The pane keeps MainViewModel as its data context and reaches into Tree by path,
           so the shared context menu can bind straight to the top-level commands. -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceBase}">
        <Grid RowDefinitions="Auto,Auto,*">

          <TextBlock Grid.Row="0" Classes="caption" Text="{l:T Results.Folders}" Margin="14,11,0,7" />

          <!-- Sortable headers. Column widths mirror the row template exactly, and the
               right margin reserves the scrollbar gutter so headers stay above their data. -->
          <Grid Grid.Row="1" ColumnDefinitions="*,88,96,68" Margin="10,0,20,0" Height="26">
            <Button Grid.Column="0" Classes="ghost col-header" Content="{Binding Tree.NameHeader}"
                    HorizontalContentAlignment="Left" Click="OnSortByName" />
            <Button Grid.Column="1" Classes="ghost col-header" Content="{Binding Tree.SizeHeader}"
                    HorizontalContentAlignment="Right" Click="OnSortBySize" />
            <TextBlock Grid.Column="2" Classes="caption" Text="{l:T Common.Share}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
            <Button Grid.Column="3" Classes="ghost col-header" Content="{Binding Tree.ItemsHeader}"
                    HorizontalContentAlignment="Right" Click="OnSortByItems" />
          </Grid>

          <ListBox Grid.Row="2" x:Name="TreeList"
                   ItemsSource="{Binding Tree.Rows}"
                   SelectedItem="{Binding Tree.SelectedRow, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   DoubleTapped="OnTreeRowDoubleTapped">

            <ListBox.ContextMenu>
              <views:NodeContextMenu />
            </ListBox.ContextMenu>


            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NodeViewModel">
                <Grid ColumnDefinitions="*,88,96,68" ToolTip.Tip="{Binding Tooltip}">

                  <!-- Name: indent expresses depth, the triangle toggles the branch.
                       A star-sized text column is what makes long names ellipsize instead
                       of spilling over the size column. -->
                  <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*"
                        Margin="{Binding Indent}" ClipToBounds="True">
                    <Button Grid.Column="0" Classes="chevron" Click="OnChevronClick"
                            IsVisible="{Binding HasChildren}" VerticalAlignment="Center">
                      <Path Fill="{DynamicResource TextTertiary}" Width="7" Height="7"
                            Stretch="Uniform"
                            Data="{Binding IsExpanded, Converter={x:Static views:Converters.Chevron}}" />
                    </Button>
                    <Border Grid.Column="1" Width="8" Height="8" CornerRadius="2"
                            Background="{Binding Swatch}" VerticalAlignment="Center"
                            Margin="{Binding HasChildren, Converter={x:Static views:Converters.LeafSpacer}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="6,0,8,0" />
                  </Grid>

                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="numeric"
                             FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />

                  <Grid Grid.Column="2" ColumnDefinitions="*,42" VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <views:FractionBar Grid.Column="0" Fraction="{Binding Fraction}"
                                       Fill="{Binding BarBrush}"
                                       Track="{DynamicResource RingTrack}"
                                       BarHeight="5" Height="14" Margin="0,0,7,0" />
                    <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                               Classes="numeric tertiary" FontSize="10.5"
                               VerticalAlignment="Center" />
                  </Grid>

                  <TextBlock Grid.Column="3" Text="{Binding ItemsText}"
                             Classes="numeric tertiary" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </Grid>
      </Border>


      <GridSplitter Grid.Column="1" Background="{DynamicResource BorderSubtle}"
                    ResizeDirection="Columns" />

      <!-- ====================================== Treemap ====================================== -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceSunken}">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="14,11,14,7">
            <TextBlock Grid.Column="0" Classes="caption" Text="{l:T Results.Treemap}" />
            <TextBlock Grid.Column="1" Classes="tertiary" FontSize="11"
                       HorizontalAlignment="Right"
                       Text="{l:T Results.ChartHint}" />
          </Grid>

          <views:TreemapControl Grid.Row="1" x:Name="Treemap"
                                Root="{Binding TreemapRoot}"
                                SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                                ZoomCommand="{Binding ZoomIntoCommand}"
                                CushionShading="True"
                                DirectoryFrames="True">
            <views:TreemapControl.ContextMenu>
              <views:NodeContextMenu />
            </views:TreemapControl.ContextMenu>
          </views:TreemapControl>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Background="{DynamicResource BorderSubtle}"
                    ResizeDirection="Columns" />

      <!-- ===================================== File types ===================================== -->
      <Border Grid.Column="4" Background="{DynamicResource SurfaceBase}">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="14,11,14,7">
            <TextBlock Grid.Column="0" Classes="caption" Text="{l:T Results.FileTypes}" />
            <TextBlock Grid.Column="1" Classes="tertiary" FontSize="10.5"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="{l:T Results.ClickToIsolate}" />
          </Grid>

          <ListBox Grid.Row="1" ItemsSource="{Binding Extensions}"
                   SelectedItem="{Binding SelectedExtension, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ExtensionViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                      ToolTip.Tip="{Binding Tooltip}">
                  <Border Grid.Row="0" Grid.Column="0" Width="10" Height="10" CornerRadius="3"
                          Background="{Binding Swatch}" VerticalAlignment="Center" Margin="0,0,9,0" />

                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}"
                             FontWeight="Medium" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />

                  <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeText}"
                             Classes="numeric secondary" FontSize="12" VerticalAlignment="Center" />

                  <views:FractionBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     Fraction="{Binding Fraction}"
                                     Fill="{Binding Swatch}"
                                     Track="{DynamicResource RingTrack}"
                                     BarHeight="4" Height="10" Margin="0,4,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- ================================================= Status bar ================================================= -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0"
            Padding="14,7">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}" Classes="tertiary" FontSize="11.5" />
          <TextBlock Text="{Binding DeniedText}" Foreground="{DynamicResource WarningBase}"
                     FontSize="11.5" IsVisible="{Binding HasDenied}"
                     ToolTip.Tip="{l:T Tooltip.Denied}" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBase}"
                     FontSize="11.5"
                     IsVisible="{Binding StatusMessage, Converter={x:Static views:Converters.HasText}}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectionDetailText}" Classes="tertiary" FontSize="11.5" />
          <Button Classes="ghost" Content="{l:T Results.ExportCsv}" Command="{Binding ExportCsvCommand}"
                  FontSize="11.5" Padding="9,4" />
          <Button Classes="ghost" Content="{l:T Results.ExportJson}" Command="{Binding ExportJsonCommand}"
                  FontSize="11.5" Padding="9,4" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================================== Options ================================================== -->
    <Border Grid.Row="1" IsVisible="{Binding IsSettingsOpen}"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,10,14,0" Width="304" Padding="18"
            Classes="card fade-in"
            Background="{DynamicResource SurfaceOverlay}"
            BorderBrush="{DynamicResource BorderStrong}"
            BoxShadow="0 18 48 0 #99000000">
      <StackPanel Spacing="14">
        <TextBlock Classes="subtitle" Text="{l:T Options.Title}" />

        <StackPanel Spacing="8">
          <Button Classes="ghost" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Command="{Binding ToggleUnitsCommand}"
                  Content="{l:T Options.Units}" />
          <Button Classes="ghost" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Command="{Binding ToggleSizeOnDiskCommand}"
                  Content="{l:T Options.SizeOnDisk}" />
          <Button Classes="ghost" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Command="{Binding ToggleThemeCommand}"
                  Content="{l:T Options.Theme}" />
        </StackPanel>

        <Border Classes="divider" />

        <StackPanel Spacing="5">
          <TextBlock Classes="caption" Text="{l:T Options.Keyboard}" />
          <TextBlock Classes="tertiary" FontSize="11.5" LineHeight="19"
                     Text="{l:T Options.Shortcuts}" />
        </StackPanel>
      </StackPanel>
    </Border>

  </Grid>

  <UserControl.Styles>
    <Style Selector="Button.crumb">
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>

    <Style Selector="Button.col-header">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.chevron">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chevron:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

</UserControl>
