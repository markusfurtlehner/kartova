<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DirStat.App.ViewModels"
        xmlns:views="using:DirStat.App.Views"
        xmlns:l="using:DirStat.App.Localization"
        mc:Ignorable="d"
        x:Class="DirStat.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DirStat"
        Width="1480" Height="940"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="Manual"
        Background="{DynamicResource SurfaceBase}"
        Icon="/Assets/dirstat.ico">

  <Grid RowDefinitions="Auto,*">

    <!-- ===================================================== Title bar -->
    <!-- A custom caption keeps the shell consistent across platforms instead of
         inheriting three different system title bars. On Linux the window manager
         insists on decorating anyway, so this degrades to a header strip there. -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="38" Background="{DynamicResource TitleBarBrush}"
          ColumnDefinitions="Auto,*,Auto"
          PointerPressed="OnTitleBarPressed"
          DoubleTapped="OnTitleBarDoubleTapped">

      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                  Margin="12,0,0,0" VerticalAlignment="Center">
        <Image Source="/Assets/dirstat-32.png" Width="17" Height="17" />
        <TextBlock Text="DirStat" FontWeight="SemiBold" FontSize="12.5"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding SelectionPathText}" Classes="tertiary"
                   FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"
                   TextTrimming="CharacterEllipsis" MaxWidth="620"
                   IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Results}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">

        <!-- Language selector. Sits left of the theme toggle, as asked, and shows the
             active language as a two-letter code so it needs no icon. -->
        <!-- The flyout opens on click by itself; no command needed. -->
        <Button Classes="caption" Width="46" ToolTip.Tip="{l:T Window.Language}">
          <TextBlock Text="{Binding LanguageCode, Source={x:Static l:Loc.Current}}"
                     FontSize="11.5" FontWeight="SemiBold" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <ItemsControl ItemsSource="{Binding Languages}" Margin="-4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <Button Classes="ghost language-item"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SetLanguageCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="11.5"
                                   Width="24" Foreground="{DynamicResource AccentBase}" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Button Classes="caption" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{l:T Window.Theme}">
          <TextBlock Text="◐" FontSize="14" />
        </Button>

        <!-- Window controls, hidden on Linux where the window manager draws its own.
             See MainWindow.ApplyPlatformChrome. -->
        <StackPanel x:Name="WindowControls" Orientation="Horizontal">
          <Button Classes="caption" Click="OnMinimize" ToolTip.Tip="{l:T Window.Minimise}">
            <TextBlock Text="—" FontSize="11" />
          </Button>
          <Button Classes="caption" Click="OnMaximize" ToolTip.Tip="{l:T Window.Maximise}">
            <TextBlock Text="□" FontSize="12" />
          </Button>
          <Button Classes="caption close" Click="OnClose" ToolTip.Tip="{l:T Window.Close}">
            <TextBlock Text="✕" FontSize="12" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ======================================================= Screens -->
    <Panel Grid.Row="1">

      <views:VolumePickerView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Volumes}" />

      <views:ScanProgressView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Scanning}" />

      <views:ResultsView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Results}" />

      <views:DuplicatesView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Duplicates}" />

      <views:InsightsView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Insights}" />

      <views:ComparisonView
        IsVisible="{Binding Screen, Converter={x:Static views:Converters.ScreenIs}, ConverterParameter=Comparison}" />

      <!-- ================================================ Confirm dialog -->
      <Panel IsVisible="{Binding IsConfirmingDelete}">
        <Border Background="{DynamicResource ScrimBrush}" />
        <Border Classes="card fade-in" Width="470" Padding="26"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceOverlay}"
                BorderBrush="{DynamicResource BorderStrong}"
                BoxShadow="0 24 64 0 #99000000">
          <StackPanel Spacing="16">
            <TextBlock Classes="title" Text="{Binding ConfirmTitle}" />
            <TextBlock Text="{Binding ConfirmBody}" Classes="secondary"
                       TextWrapping="Wrap" LineHeight="20" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Content="{l:T Common.Cancel}" Command="{Binding CancelDeleteCommand}" />
              <Button Classes="danger" Content="{l:T Common.Continue}" Command="{Binding ConfirmDeleteCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>

    </Panel>
  </Grid>
</Window>
