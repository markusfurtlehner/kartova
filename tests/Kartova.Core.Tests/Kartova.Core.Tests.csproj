<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kartova.Core.Tests</RootNamespace>
    <AssemblyName>Kartova.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Kartova.Core/Kartova.Core.csproj" />
    <!-- Referenced so the string catalogues can be checked for parity. The tests touch
         only static dictionaries, so no Avalonia runtime is started. -->
    <ProjectReference Include="../../src/Kartova.App/Kartova.App.csproj" />
  </ItemGroup>

</Project>
